#!/bin/sh

# Tests that require a real git repository and executable.

. ./common.sh

# check if git is available; exit if not
check_git()
{
    check_available \
      "git --version" \
      "git version" \
      "git not found: skipping this test script"
}

find_gitrepo()
{
    gitrepo="$testdir/git-repo.tar"
    if [ ! -f $gitrepo ]; then
        echo "$gitrepo not found" >&2
        exit 1
    fi
}

pretest()
{
    cd $tmpdir
    if [ ! -d git-repo -o -f git-repo/.git/tainted ]; then
        #echo "unpacking $gitrepo"
        rm -rf git-repo
        tar -xf $gitrepo
    fi
    cd git-repo

    # weird: git diff --quiet gives incorrect results on the 
    # first run after untar'ing, so run it once now to get
    # past that
    git diff --quiet || true
}

posttest()
{
    :
}

# default prompt format in our test repo
test_basics()
{
    pretest
    assert_vcprompt "show branch" "master" "%b"
    assert_vcprompt "show modified" "+" "%m"
    assert_vcprompt "show unknown" "?" "%u"
    posttest
}

# "%m" expands to nothing if no uncommitted changes
test_no_modified()
{
    pretest
    touch .git/tainted
    assert_vcprompt "modified and unknown" "master+?" "%b%m%u"
    git reset -q --hard HEAD
    assert_vcprompt "no modified files, still 1 unknown" "master?" "%b%m%u"
    posttest
}

# "%u" expands to nothing if no unknown files
test_no_unknown()
{
    pretest
    touch .git/tainted
    rm -f junk
    assert_vcprompt "modified and ignore, no unknown" "master+" "%b%m%u"
    rm -f a.o
    assert_vcprompt "modified, no ignored, no unknown" "master+" "%b%m%u"
    git reset -q --hard HEAD
    assert_vcprompt "no modified, no ignored, no unknown" "master" "%b%m%u"
    posttest
}

# "%a" expands to "*" if there are staged files, nothing otherwise
test_staged_files()
{
    pretest
    touch .git/tainted
    assert_vcprompt "nothing staged" "" "%a"
    touch newfile
    git add newfile
    assert_vcprompt "staged" "*" "%a"
    git reset -q --hard HEAD
    posttest
}

# a linked worktree keeps .git as a *file* pointing at the real gitdir;
# both the branch and the revision must still resolve
test_worktree()
{
    pretest
    touch .git/tainted
    rm -rf $tmpdir/worktree
    git worktree add -q -b wtbranch $tmpdir/worktree >/dev/null 2>&1
    revision=`git rev-parse --short=12 wtbranch`

    cd $tmpdir/worktree
    assert_vcprompt "worktree branch" "wtbranch" "%b"
    assert_vcprompt "worktree revision" "$revision" "%r"
    cd $tmpdir/git-repo

    git worktree remove --force $tmpdir/worktree >/dev/null 2>&1
    git branch -q -D wtbranch
    posttest
}

# "git gc", "git pack-refs" and a fresh clone all move refs out of
# refs/heads and into the packed-refs file
test_packed_refs()
{
    pretest
    touch .git/tainted
    revision=`git rev-parse --short=12 HEAD`

    git pack-refs --all
    if [ -f .git/refs/heads/master ]; then
        echo "skip: this git kept a loose ref after pack-refs"
        posttest
        return
    fi
    assert_vcprompt "packed refs" "master:$revision" "%b:%r"
    posttest
}

# a worktree must find its branch in the main repository's packed-refs too
test_packed_refs_worktree()
{
    pretest
    touch .git/tainted
    revision=`git rev-parse --short=12 HEAD`

    rm -rf $tmpdir/packed-wt
    git worktree add -q -b packedbranch $tmpdir/packed-wt >/dev/null 2>&1
    git pack-refs --all
    if [ -f .git/refs/heads/packedbranch ]; then
        echo "skip: this git kept a loose ref after pack-refs"
        posttest
        return
    fi

    cd $tmpdir/packed-wt
    assert_vcprompt "packed refs in worktree" "packedbranch:$revision" "%b:%r"
    cd $tmpdir/git-repo

    git worktree remove --force $tmpdir/packed-wt >/dev/null 2>&1
    git branch -q -D packedbranch
    posttest
}

# a submodule uses the same .git pointer file as a worktree, except that
# the path is relative to the submodule directory; the submodule's own
# branch and revision are reported, not the superproject's
test_submodule()
{
    pretest
    touch .git/tainted

    rm -rf $tmpdir/submodule-src
    git init -q $tmpdir/submodule-src
    (cd $tmpdir/submodule-src &&
     git config user.name "test" &&
     git config user.email "test" &&
     # a branch name distinct from the superproject's, so that the
     # assertions below cannot pass by reporting the superproject
     git symbolic-ref HEAD refs/heads/submodulebranch &&
     echo sub > subfile &&
     git add subfile &&
     git commit -q -m "add subfile")
    subbranch=`cd $tmpdir/submodule-src && git rev-parse --abbrev-ref HEAD`
    subrevision=`cd $tmpdir/submodule-src && git rev-parse --short=12 HEAD`

    git -c protocol.file.allow=always submodule add -q \
        $tmpdir/submodule-src sub >/dev/null 2>&1

    if [ ! -f sub/.git ]; then
        echo "skip: this git does not use .git pointer files for submodules"
        posttest
        return
    fi

    cd sub
    assert_vcprompt "submodule branch" "$subbranch" "%b"
    assert_vcprompt "submodule revision" "$subrevision" "%r"
    cd ..

    rm -rf $tmpdir/submodule-src
    posttest
}

# a "git status" line longer than vcprompt's read buffer must not have its
# tail parsed as though it were a second status line
test_long_path()
{
    pretest
    touch .git/tainted

    seg=`awk 'BEGIN { s = ""; while (length(s) < 200) s = s "d"; print s }'`
    dir="$seg/$seg/$seg/$seg/$seg/$seg/$seg"
    if ! mkdir -p "$dir" 2>/dev/null; then
        echo "skip: filesystem will not take a 1400-character path"
        posttest
        return
    fi

    echo deep > "$dir/deep"
    git add -A
    git commit -q -m "deep file"

    # modify it in the working tree only: "%a" must stay empty, which it
    # will not if the truncated tail of the status line is misparsed
    echo modified >> "$dir/deep"
    assert_vcprompt "long status line" "+" "%m%a"

    git reset -q --hard HEAD
    posttest
}

# a stale or foreign .git file must not stop the search: vcprompt should
# keep walking up and report the enclosing repository
test_stale_gitdir()
{
    pretest
    touch .git/tainted
    revision=`git rev-parse --short=12 HEAD`

    mkdir -p stale
    echo "gitdir: /nonexistent/.git/worktrees/gone" > stale/.git
    cd stale
    assert_vcprompt "stale pointer falls back" "master:$revision" "%b:%r"
    cd ..

    mkdir -p junkdir
    echo "not a gitdir pointer at all" > junkdir/.git
    cd junkdir
    assert_vcprompt "foreign .git file falls back" "master:$revision" "%b:%r"
    cd ..

    rm -rf stale junkdir
    posttest
}

check_git
find_vcprompt
find_gitrepo
setup

failed=""

#set -e
test_basics
test_no_modified
test_no_unknown
test_staged_files
test_worktree
test_packed_refs
test_packed_refs_worktree
test_submodule
test_long_path
test_stale_gitdir

report
